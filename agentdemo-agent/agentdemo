#!/bin/bash
# Safe-vs-hijacked AI agent demo against the OWNED crAPI training lab via MCP. Extra args go to the agent.
#   agentdemo --scripted        reliable traffic, no LLM
#   agentdemo                   LLM-driven (default)
exec sudo podman run --rm --name agentdemo-manual --network host --env-file /opt/labagents/labagents.env \
  -v /opt/labagents/data:/data:z localhost/labagents:latest labagents.agentdemo "$@"
