[Unit]
Description=Lab service map + agent reports web server on :9440 (embedded/linked from Grafana)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 /opt/labagents/app/servicemap_web.py
Environment=SERVICEMAP_SITE=/opt/labagents/data/servicemap/site
# Report folders, read-only. /opt/secnews stays root-only (it holds secnews.env); only its reports are mounted.
TemporaryFileSystem=/srv:ro
BindReadOnlyPaths=/opt/labagents/data/reports/labwatch:/srv/reports/labwatch
BindReadOnlyPaths=/opt/labagents/data/reports/cvewatch:/srv/reports/cvewatch
BindReadOnlyPaths=/opt/labagents/data/reports/patchwatch:/srv/reports/patchwatch
BindReadOnlyPaths=/opt/labagents/data/reports/servicemap:/srv/reports/servicemap
BindReadOnlyPaths=/opt/secnews/data/reports:/srv/reports/secnews
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
