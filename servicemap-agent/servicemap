#!/bin/bash
# Run the lab service map now: collect, label, render, publish. Extra args go to the agent (try --help).
# Steps: servicemap collect | servicemap agent [args] | servicemap publish [--force] | servicemap (all three)
set -e
step=${1:-all}; [ $# -gt 0 ] && shift
collect() { sudo -u mcropsey python3 /opt/labagents/app/servicemap_collect.py "$@"; }
agent() { sudo podman run --rm --name servicemap-manual --network host --env-file /opt/labagents/labagents.env \
  -v /opt/labagents/data:/data:z localhost/labagents:latest labagents.servicemap "$@"; }
publish() { sudo -u mcropsey /opt/labagents/app/servicemap_publish.sh "$@"; }
case $step in
  collect) collect "$@" ;; agent) agent "$@" ;; publish) publish "$@" ;;
  all) collect; agent "$@"; publish ;;
  *) echo "usage: servicemap [collect|agent|publish|all] [args]" >&2; exit 2 ;;
esac
