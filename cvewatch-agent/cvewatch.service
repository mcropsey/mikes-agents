[Unit]
Description=CVE-to-lab matcher (cvewatch-agent)
Wants=network-online.target
After=network-online.target
After=labinventory.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --name cvewatch --network host --env-file /opt/labagents/labagents.env -v /opt/labagents/data:/data:z localhost/labagents:latest labagents.cvewatch
TimeoutStartSec=45min
