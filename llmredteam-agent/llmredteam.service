[Unit]
Description=Weekly LLM guardrail eval (llmredteam-agent)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --replace --name llmredteam --network host --env-file /opt/labagents/labagents.env -v /opt/labagents/data:/data:z localhost/labagents:latest labagents.llmredteam
TimeoutStartSec=30min
