{
  "uid": "agent-daily-reports",
  "title": "Agent Lab · Daily Reports",
  "description": "All five mikes-agents (labwatch, cvewatch, patchwatch, secnews, servicemap): status, findings, and full report text. Data: Prometheus (agenthub exporter :9430) + Loki (report logs).",
  "tags": [
    "mikes-agents",
    "reports"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "labwatch · lab health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "GREEN",
                  "color": "green"
                },
                "1": {
                  "text": "YELLOW",
                  "color": "yellow"
                },
                "2": {
                  "text": "RED",
                  "color": "red"
                },
                "3": {
                  "text": "UNKNOWN",
                  "color": "gray-dark"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mikes_agent_status_code{agent=\"labwatch\"}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
