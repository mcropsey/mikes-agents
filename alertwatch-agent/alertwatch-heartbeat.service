[Unit]
Description=Alert triage heartbeat (alertwatch-agent --test)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --name alertwatch-beat --network host --env-file /opt/labagents/labagents.env -v /opt/labagents/data:/data:z localhost/labagents:latest labagents.alertwatch --test
TimeoutStartSec=30min
