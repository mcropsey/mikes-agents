{
 "uid": "litellm-gateway",
 "title": "LiteLLM Gateway",
 "tags": [
  "litellm",
  "mikes-agents"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "Agent Lab \u00b7 Agents II",
   "type": "link",
   "url": "/d/agent-lab-ii",
   "targetBlank": false
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "LiteLLM gateway (.101) \u2014 native metrics",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "All lab agents reach the local model only through this gateway. These panels come straight from LiteLLM's own Prometheus metrics (`/metrics`, `callbacks: [\"prometheus\"]`, enabled 2026-10-19). **Guardrails** are LiteLLM's `basic-safety-filter` (BLOCK on harmful categories); a block appears as a **failed request with status 400** below, and its processing cost shows in *guardrail overhead latency*. For guardrail *effectiveness* (does it catch bad prompts) see the weekly **llmredteam** agent on [Agent Lab \u00b7 Agents II](/d/agent-lab-ii)."
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Requests (total)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 3
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(litellm_proxy_total_requests_metric_total)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Failed / blocked (total)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 3
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(litellm_proxy_failed_requests_metric_total) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "id": 3
  },
